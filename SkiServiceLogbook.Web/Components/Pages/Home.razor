@page "/"

<PageTitle>Etusivu - Hiihtovoide Logbook</PageTitle>

<h1>Tervetuloa Hiihtovoide Logbook -järjestelmään</h1>

<p class="lead">Hallitse suksiparia, voiteita ja testituloksia.</p>

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-clipboard-data"></i> Varasto</h5>
                <p class="card-text">Hallitse suksiparia ja voiteita.</p>
                <a href="/inventory/skis" class="btn btn-primary">Suksiparit</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-speedometer2"></i> Testit</h5>
                <p class="card-text">Luo uusia testejä ja seuraa tuloksia.</p>
                <a href="/tests/new" class="btn btn-primary">Uusi testi</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-search"></i> Haku</h5>
                <p class="card-text">Etsi aiempia testejä ja voiteluohjeita.</p>
                <a href="/search" class="btn btn-primary">Haku</a>
            </div>
        </div>
    </div>
</div>
