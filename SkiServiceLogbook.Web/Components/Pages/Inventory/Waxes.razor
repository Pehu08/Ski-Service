@page "/inventory/waxes"
@rendermode InteractiveServer
@* @attribute [Authorize(Policy = "CanManageInventory")] *@
@using SkiServiceLogbook.Domain.Entities
@using SkiServiceLogbook.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@using System.ComponentModel.DataAnnotations
@inject SkiServiceDbContext DbContext

<PageTitle>Voiteet</PageTitle>

<h3>Voiteet</h3>

@if (errorMessage != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" @onclick="@(() => errorMessage = null)"></button>
    </div>
}

@if (successMessage != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" @onclick="@(() => successMessage = null)"></button>
    </div>
}

@if (showDeleteConfirm)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Vahvista poisto</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>Haluatko varmasti poistaa voideen <strong>@waxToDelete?.Name</strong>?</p>
                    <p class="text-muted">Tämä toiminto ei ole palautettavissa.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelDelete">Peruuta</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">Poista</button>
                </div>
            </div>
        </div>
    </div>
}

@if (isLoading)
{
    <p><em>Ladataan...</em></p>
}
else if (isEditing)
{
    <div class="card mb-4">
        <div class="card-header">
            <h5>@(waxFormModel.Id == 0 ? "Lisää uusi voide" : "Muokkaa voidetta")</h5>
        </div>
        <div class="card-body">
            <EditForm Model="waxFormModel" OnValidSubmit="SaveWax">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />

                <div class="mb-3">
                    <label class="form-label">Nimi: *</label>
                    <InputText @bind-Value="waxFormModel.Name" class="form-control" />
                    <ValidationMessage For="@(() => waxFormModel.Name)" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Valmistaja: *</label>
                    <InputText @bind-Value="waxFormModel.Manufacturer" class="form-control" />
                    <ValidationMessage For="@(() => waxFormModel.Manufacturer)" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Kategoria: *</label>
                    <InputSelect @bind-Value="waxFormModel.WaxCategoryId" class="form-select">
                        <option value="0">-- Valitse kategoria --</option>
                        @foreach (var category in waxCategories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => waxFormModel.WaxCategoryId)" />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Min. lämpötila (°C): *</label>
                        <InputNumber @bind-Value="waxFormModel.MinTemperature" class="form-control" />
                        <ValidationMessage For="@(() => waxFormModel.MinTemperature)" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Max. lämpötila (°C): *</label>
                        <InputNumber @bind-Value="waxFormModel.MaxTemperature" class="form-control" />
                        <ValidationMessage For="@(() => waxFormModel.MaxTemperature)" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Min. kosteus (%):</label>
                        <InputNumber @bind-Value="waxFormModel.MinHumidity" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Max. kosteus (%):</label>
                        <InputNumber @bind-Value="waxFormModel.MaxHumidity" class="form-control" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Lumiolosuhteet:</label>
                    <InputText @bind-Value="waxFormModel.SnowCondition" class="form-control" />
                </div>

                <div class="mb-3 form-check">
                    <InputCheckbox @bind-Value="waxFormModel.IsActive" class="form-check-input" id="isActive" />
                    <label class="form-check-label" for="isActive">Aktiivinen</label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Tallenna</button>
                    <button type="button" class="btn btn-secondary" @onclick="CancelEdit">Peruuta</button>
                </div>
            </EditForm>
        </div>
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <button class="btn btn-primary" @onclick="ShowCreateForm">Lisää uusi voide</button>
        
        <div class="btn-group" role="group">
            <button type="button" class="btn @(selectedCategoryFilter == null ? "btn-primary" : "btn-outline-primary")" 
                    @onclick="() => FilterByCategory(null)">
                Kaikki
            </button>
            @foreach (var category in waxCategories)
            {
                <button type="button" class="btn @(selectedCategoryFilter == category.Id ? "btn-primary" : "btn-outline-primary")" 
                        @onclick="() => FilterByCategory(category.Id)">
                    @category.Name
                </button>
            }
        </div>
    </div>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Nimi</th>
                <th>Valmistaja</th>
                <th>Kategoria</th>
                <th>Lämpötila-alue</th>
                <th>Lumityyppi</th>
                <th>Tila</th>
                <th>Toiminnot</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var wax in filteredWaxes)
            {
                <tr>
                    <td><strong>@wax.Name</strong></td>
                    <td>@wax.Manufacturer</td>
                    <td>
                        <span class="badge @GetCategoryBadgeClass(wax.WaxCategory.Name)">
                            @wax.WaxCategory.Name
                        </span>
                    </td>
                    <td>@FormatTemperatureRange(wax.MinTemperature, wax.MaxTemperature)</td>
                    <td>@(wax.SnowCondition ?? "-")</td>
                    <td>
                        @if (wax.IsActive)
                        {
                            <span class="badge bg-success">Aktiivinen</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Ei käytössä</span>
                        }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-warning me-1" @onclick="() => EditWax(wax)">Muokkaa</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => ShowDeleteConfirm(wax)">Poista</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    
    @if (!filteredWaxes.Any())
    {
        <div class="alert alert-info">
            Ei voiteita valitussa kategoriassa.
        </div>
    }
}

@code {
    private List<Wax> waxes = new();
    private List<Wax> filteredWaxes = new();
    private List<WaxCategory> waxCategories = new();
    private int? selectedCategoryFilter = null;
    private bool isLoading = true;
    private bool isEditing = false;
    private bool showDeleteConfirm = false;
    private Wax? waxToDelete = null;
    private WaxFormModel waxFormModel = new();
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadWaxCategories();
        await LoadWaxes();
        isLoading = false;
    }

    private async Task LoadWaxes()
    {
        waxes = await DbContext.Waxes
            .Include(w => w.WaxCategory)
            .OrderBy(w => w.WaxCategory.DisplayOrder)
            .ThenBy(w => w.Name)
            .ToListAsync();
        
        ApplyFilter();
    }

    private async Task LoadWaxCategories()
    {
        waxCategories = await DbContext.WaxCategories
            .OrderBy(c => c.DisplayOrder)
            .ToListAsync();
    }

    private void FilterByCategory(int? categoryId)
    {
        selectedCategoryFilter = categoryId;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (selectedCategoryFilter.HasValue)
        {
            filteredWaxes = waxes.Where(w => w.WaxCategoryId == selectedCategoryFilter.Value).ToList();
        }
        else
        {
            filteredWaxes = waxes.ToList();
        }
    }

    private void ShowCreateForm()
    {
        waxFormModel = new WaxFormModel { IsActive = true };
        isEditing = true;
        errorMessage = null;
        successMessage = null;
    }

    private void EditWax(Wax wax)
    {
        waxFormModel = new WaxFormModel
        {
            Id = wax.Id,
            Name = wax.Name,
            Manufacturer = wax.Manufacturer,
            WaxCategoryId = wax.WaxCategoryId,
            MinTemperature = wax.MinTemperature,
            MaxTemperature = wax.MaxTemperature,
            MinHumidity = wax.MinHumidity,
            MaxHumidity = wax.MaxHumidity,
            SnowCondition = wax.SnowCondition,
            IsActive = wax.IsActive
        };
        isEditing = true;
        errorMessage = null;
        successMessage = null;
    }

    private async Task SaveWax()
    {
        try
        {
            if (waxFormModel.Id == 0)
            {
                // Uusi voide
                var wax = new Wax
                {
                    Name = waxFormModel.Name!,
                    Manufacturer = waxFormModel.Manufacturer!,
                    WaxCategoryId = waxFormModel.WaxCategoryId,
                    MinTemperature = waxFormModel.MinTemperature,
                    MaxTemperature = waxFormModel.MaxTemperature,
                    MinHumidity = waxFormModel.MinHumidity,
                    MaxHumidity = waxFormModel.MaxHumidity,
                    SnowCondition = waxFormModel.SnowCondition,
                    IsActive = waxFormModel.IsActive
                };
                DbContext.Waxes.Add(wax);
                successMessage = "Voide lisätty onnistuneesti.";
            }
            else
            {
                // Päivitä olemassa oleva
                var wax = await DbContext.Waxes.FindAsync(waxFormModel.Id);
                if (wax != null)
                {
                    wax.Name = waxFormModel.Name!;
                    wax.Manufacturer = waxFormModel.Manufacturer!;
                    wax.WaxCategoryId = waxFormModel.WaxCategoryId;
                    wax.MinTemperature = waxFormModel.MinTemperature;
                    wax.MaxTemperature = waxFormModel.MaxTemperature;
                    wax.MinHumidity = waxFormModel.MinHumidity;
                    wax.MaxHumidity = waxFormModel.MaxHumidity;
                    wax.SnowCondition = waxFormModel.SnowCondition;
                    wax.IsActive = waxFormModel.IsActive;
                    successMessage = "Voide päivitetty onnistuneesti.";
                }
            }

            await DbContext.SaveChangesAsync();
            await LoadWaxes();
            isEditing = false;
        }
        catch (Exception ex)
        {
            errorMessage = $"Virhe tallennuksessa: {ex.Message}";
        }
    }

    private void ShowDeleteConfirm(Wax wax)
    {
        waxToDelete = wax;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        waxToDelete = null;
        showDeleteConfirm = false;
    }

    private async Task ConfirmDelete()
    {
        if (waxToDelete == null) return;

        try
        {
            DbContext.Waxes.Remove(waxToDelete);
            await DbContext.SaveChangesAsync();
            await LoadWaxes();
            successMessage = $"Voide '{waxToDelete.Name}' poistettu onnistuneesti.";
            waxToDelete = null;
            showDeleteConfirm = false;
        }
        catch (Exception ex)
        {
            errorMessage = $"Virhe poistossa: {ex.Message}";
            showDeleteConfirm = false;
        }
    }

    private void CancelEdit()
    {
        isEditing = false;
        errorMessage = null;
    }

    private string FormatTemperatureRange(decimal? min, decimal? max)
    {
        if (min.HasValue && max.HasValue)
            return $"{min:F1}°C - {max:F1}°C";
        if (min.HasValue)
            return $"{min:F1}°C+";
        if (max.HasValue)
            return $"< {max:F1}°C";
        return "-";
    }

    private string GetCategoryBadgeClass(string categoryName)
    {
        return categoryName switch
        {
            "Luistovoide" => "bg-primary",
            "Pitovoide" => "bg-success",
            "Pinnoite" => "bg-warning text-dark",
            _ => "bg-secondary"
        };
    }

    private class WaxFormModel
    {
        public int Id { get; set; }
        
        [Required(ErrorMessage = "Nimi on pakollinen")]
        public string? Name { get; set; }
        
        [Required(ErrorMessage = "Valmistaja on pakollinen")]
        public string? Manufacturer { get; set; }
        
        [Required(ErrorMessage = "Kategoria on pakollinen")]
        [Range(1, int.MaxValue, ErrorMessage = "Valitse kategoria")]
        public int WaxCategoryId { get; set; }
        
        [Required(ErrorMessage = "Min. lämpötila on pakollinen")]
        public decimal? MinTemperature { get; set; }
        
        [Required(ErrorMessage = "Max. lämpötila on pakollinen")]
        public decimal? MaxTemperature { get; set; }
        
        public decimal? MinHumidity { get; set; }
        public decimal? MaxHumidity { get; set; }
        public string? SnowCondition { get; set; }
        public bool IsActive { get; set; }
    }
}
