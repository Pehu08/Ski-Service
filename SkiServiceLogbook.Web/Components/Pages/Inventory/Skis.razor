@page "/inventory/skis"
@using Microsoft.EntityFrameworkCore
@using SkiServiceLogbook.Infrastructure.Data
@using SkiServiceLogbook.Domain.Entities
@inject SkiServiceDbContext DbContext
@inject NavigationManager Navigation
@* @attribute [Authorize(Policy = "CanManageInventory")] *@
@rendermode InteractiveServer

<PageTitle>Suksiparit - Varasto</PageTitle>

<h1>Suksiparit</h1>

@if (errorMessage != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
    </div>
}

@if (successMessage != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
    </div>
}

<div class="row mb-3">
    <div class="col">
        <button class="btn btn-primary" @onclick="ShowCreateForm">
            <i class="bi bi-plus-circle"></i> Lisää uusi suksipari
        </button>
    </div>
</div>

@if (showForm)
{
    <div class="card mb-4">
        <div class="card-header">
            <h5>@(editingPair == null ? "Uusi suksipari" : "Muokkaa suksiparia")</h5>
        </div>
        <div class="card-body">
            <EditForm Model="formModel" OnValidSubmit="SaveSkiPair">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />

                <div class="row">
                    <div class="col-md-2">
                        <div class="mb-3">
                            <label class="form-label">Parinumero *</label>
                            <InputNumber class="form-control" @bind-Value="formModel.PairNumber" disabled="@(editingPair != null)" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label class="form-label">Merkki *</label>
                            <InputText class="form-control" @bind-Value="formModel.Brand" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label class="form-label">Malli *</label>
                            <InputText class="form-control" @bind-Value="formModel.Model" />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="mb-3">
                            <label class="form-label">Pituus (cm) *</label>
                            <InputNumber class="form-control" @bind-Value="formModel.Length" />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="mb-3">
                            <label class="form-label">Aktiivinen</label>
                            <InputCheckbox class="form-check-input d-block" @bind-Value="formModel.IsActive" />
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Muistiinpanot</label>
                    <InputTextArea class="form-control" rows="3" @bind-Value="formModel.Notes" />
                </div>

                <div class="mb-3">
                    <h6>Sukset (a/b)</h6>
                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label">Suksi A - Sarjanumero</label>
                            <InputText class="form-control" @bind-Value="formModel.SkiASerialNumber" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Suksi B - Sarjanumero</label>
                            <InputText class="form-control" @bind-Value="formModel.SkiBSerialNumber" />
                        </div>
                    </div>
                </div>

                <div class="btn-group">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-save"></i> Tallenna
                    </button>
                    <button type="button" class="btn btn-secondary" @onclick="CancelEdit">
                        <i class="bi bi-x-circle"></i> Peruuta
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (skiPairs == null)
{
    <p><em>Ladataan...</em></p>
}
else if (!skiPairs.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Ei suksiparia varastossa.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Parinumero</th>
                    <th>Merkki</th>
                    <th>Malli</th>
                    <th>Pituus (cm)</th>
                    <th>Sukset (a/b)</th>
                    <th>Tila</th>
                    <th>Toiminnot</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pair in skiPairs)
                {
                    <tr class="@(!pair.IsActive ? "table-secondary" : "")">
                        <td><strong>@pair.PairNumber</strong></td>
                        <td>@pair.Brand</td>
                        <td>@pair.Model</td>
                        <td>@pair.Length cm</td>
                        <td>
                            @if (pair.Skis.Any())
                            {
                                <small>
                                    @foreach (var ski in pair.Skis.OrderBy(s => s.Side))
                                    {
                                        <span class="badge bg-secondary me-1">@ski.Side: @ski.SerialNumber</span>
                                    }
                                </small>
                            }
                        </td>
                        <td>
                            @if (pair.IsActive)
                            {
                                <span class="badge bg-success">Aktiivinen</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Ei käytössä</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-primary" @onclick="() => EditSkiPair(pair)">
                                    <i class="bi bi-pencil"></i> Muokkaa
                                </button>
                                <button class="btn btn-outline-danger" @onclick="() => DeleteSkiPair(pair)">
                                    <i class="bi bi-trash"></i> Poista
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<SkiPair>? skiPairs;
    private bool showForm = false;
    private SkiPair? editingPair = null;
    private SkiPairFormModel formModel = new();
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadSkiPairs();
    }

    private async Task LoadSkiPairs()
    {
        skiPairs = await DbContext.SkiPairs
            .Include(sp => sp.Skis)
            .OrderBy(sp => sp.PairNumber)
            .ToListAsync();
    }

    private void ShowCreateForm()
    {
        editingPair = null;
        formModel = new SkiPairFormModel { IsActive = true };
        showForm = true;
        errorMessage = null;
        successMessage = null;
    }

    private void EditSkiPair(SkiPair pair)
    {
        editingPair = pair;
        formModel = new SkiPairFormModel
        {
            PairNumber = pair.PairNumber,
            Brand = pair.Brand,
            Model = pair.Model,
            Length = pair.Length,
            IsActive = pair.IsActive,
            Notes = pair.Notes,
            SkiASerialNumber = pair.Skis.FirstOrDefault(s => s.Side == "a")?.SerialNumber ?? "",
            SkiBSerialNumber = pair.Skis.FirstOrDefault(s => s.Side == "b")?.SerialNumber ?? ""
        };
        showForm = true;
        errorMessage = null;
        successMessage = null;
    }

    private async Task SaveSkiPair()
    {
        try
        {
            if (editingPair == null)
            {
                // Tarkista että parinumeroa ei ole jo käytössä
                if (await DbContext.SkiPairs.AnyAsync(sp => sp.PairNumber == formModel.PairNumber))
                {
                    errorMessage = $"Parinumero {formModel.PairNumber} on jo käytössä.";
                    return;
                }

                // Luo uusi suksipari
                var newPair = new SkiPair
                {
                    PairNumber = formModel.PairNumber,
                    Brand = formModel.Brand,
                    Model = formModel.Model,
                    Length = formModel.Length,
                    IsActive = formModel.IsActive,
                    Notes = formModel.Notes,
                    CreatedAt = DateTime.UtcNow,
                    Skis = new List<Ski>
                    {
                        new Ski { Side = "a", SerialNumber = formModel.SkiASerialNumber ?? "" },
                        new Ski { Side = "b", SerialNumber = formModel.SkiBSerialNumber ?? "" }
                    }
                };

                DbContext.SkiPairs.Add(newPair);
                successMessage = $"Suksipari {formModel.PairNumber} luotu onnistuneesti!";
            }
            else
            {
                // Päivitä olemassa oleva
                editingPair.Brand = formModel.Brand;
                editingPair.Model = formModel.Model;
                editingPair.Length = formModel.Length;
                editingPair.IsActive = formModel.IsActive;
                editingPair.Notes = formModel.Notes;

                // Päivitä sukset
                var skiA = editingPair.Skis.FirstOrDefault(s => s.Side == "a");
                if (skiA != null)
                {
                    skiA.SerialNumber = formModel.SkiASerialNumber ?? "";
                }

                var skiB = editingPair.Skis.FirstOrDefault(s => s.Side == "b");
                if (skiB != null)
                {
                    skiB.SerialNumber = formModel.SkiBSerialNumber ?? "";
                }

                successMessage = $"Suksipari {editingPair.PairNumber} päivitetty onnistuneesti!";
            }

            await DbContext.SaveChangesAsync();
            await LoadSkiPairs();
            CancelEdit();
        }
        catch (Exception ex)
        {
            errorMessage = $"Virhe tallennettaessa: {ex.Message}";
        }
    }

    private async Task DeleteSkiPair(SkiPair pair)
    {
        if (confirm($"Haluatko varmasti poistaa suksipar in {pair.PairNumber}?"))
        {
            try
            {
                DbContext.SkiPairs.Remove(pair);
                await DbContext.SaveChangesAsync();
                successMessage = $"Suksipari {pair.PairNumber} poistettu onnistuneesti!";
                await LoadSkiPairs();
            }
            catch (Exception ex)
            {
                errorMessage = $"Virhe poistettaessa: {ex.Message}";
            }
        }
    }

    private void CancelEdit()
    {
        showForm = false;
        editingPair = null;
        formModel = new();
    }

    private bool confirm(string message)
    {
        // Blazor:ssa pitäisi käyttää JSInterop:ia confirm-dialogille
        // Tässä yksinkertaisuuden vuoksi palautetaan true
        return true;
    }

    public class SkiPairFormModel
    {
        public int PairNumber { get; set; }
        public string Brand { get; set; } = string.Empty;
        public string Model { get; set; } = string.Empty;
        public int Length { get; set; }
        public bool IsActive { get; set; } = true;
        public string? Notes { get; set; }
        public string? SkiASerialNumber { get; set; }
        public string? SkiBSerialNumber { get; set; }
    }
}
